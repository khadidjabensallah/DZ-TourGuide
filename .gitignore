# ============================================
# Django Migrations - IMPORTANT DECISION
# ============================================
# Option 1: Track migrations (RECOMMENDED for team work)
# Keep migrations in git so team has same database schema

# Option 2: Don't track migrations (Uncomment if you prefer)
# */migrations/*.py
# !*/migrations/__init__.py

# RECOMMENDATION: Keep migrations tracked for team collaboration
# Only ignore if you have a different migration strategy

