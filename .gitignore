*.sql

# Media files (user uploads) - Don't commit uploaded files
media/
!media/.gitkeep

# Static files (collected by collectstatic)
staticfiles/
!staticfiles/.gitkeep
static/collected/

# Local settings - Each developer has their own
local_settings.py
settings_local.py

