# Frontend environment variables (Vite)
# Copy to `.env.development` for local dev. In production, set VITE_API_URL
# in the Vercel project settings (Project → Settings → Environment Variables).

# Base URL of the Django backend API. The `/api` suffix is optional — the app
# appends it automatically if missing.
#   Local dev:   http://127.0.0.1:8000/api
#   Production:  https://your-backend-host.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api
